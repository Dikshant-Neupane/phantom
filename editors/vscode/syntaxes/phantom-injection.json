{
  "scopeName": "phantom.injection",
  "injectionSelector": "L:source.python comment.line.number-sign.python",
  "patterns": [
    {
      "include": "#instruction"
    }
  ],
  "repository": {
    "instruction": {
      "match": "(?<=#:)\\s*(phantom)(:)([0-9]+\\.[0-9]+\\.[0-9]+)\\s+([a-z][a-z0-9]*)(\\.)([a-z][a-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.phantom" },
        "2": { "name": "punctuation.separator.phantom" },
        "3": { "name": "constant.numeric.version.phantom" },
        "4": { "name": "entity.name.namespace.phantom" },
        "5": { "name": "punctuation.accessor.phantom" },
        "6": { "name": "entity.name.function.phantom" }
      }
    }
  }
}
